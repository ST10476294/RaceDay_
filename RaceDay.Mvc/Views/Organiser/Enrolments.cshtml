@model EventEnrolmentsViewModel
@{ ViewData["Title"] = "Enrolments"; }
<h1 class="rd-title">Enrolments</h1>
<p class="rd-meta">@Model.Event.Name · @Display.Date(Model.Event.EventDate)</p>
@if (Model.Enrolments.Count == 0)
{
    <div class="rd-empty"><h2>No enrolments yet</h2><p>Entries will appear here as Participants enter.</p></div>
}
else
{
    <div class="table-responsive rd-table">
        <table class="table align-middle mb-0">
            <thead><tr><th>Participant</th><th>Email</th><th>Category</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var e in Model.Enrolments)
                {
                    <tr>
                        <td>@e.ParticipantName</td>
                        <td>@e.ParticipantEmail</td>
                        <td>@e.CategoryName</td>
                        <td><partial name="_StatusBadge" model="e.Status" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
<div class="mt-3 d-flex gap-2">
    <a class="btn btn-outline-secondary" asp-action="Dashboard">Back to dashboard</a>
    @if (Model.HasFinished) { <a class="btn rd-btn" asp-action="Results" asp-route-id="@Model.Event.EventId">Capture results</a> }
</div>
