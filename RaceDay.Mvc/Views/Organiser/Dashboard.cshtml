@model List<OrganiserEventDto>
@{
    ViewData["Title"] = "Dashboard";
    var now = DateTime.Now;
    var upcoming = Model.Where(x => x.Event.EventDate > now).ToList();
    var next = upcoming.FirstOrDefault();
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="rd-title mb-0">Dashboard</h1>
    <a class="btn rd-btn" asp-action="Create">New event</a>
</div>
<div class="row g-3 mb-4">
    <div class="col-sm-4"><div class="rd-stat"><strong>@Model.Count</strong><span>Events created</span></div></div>
    <div class="col-sm-4"><div class="rd-stat"><strong>@Model.Sum(x => x.TotalEnrolments)</strong><span>Total enrolments</span></div></div>
    <div class="col-sm-4"><div class="rd-stat"><strong class="rd-stat-text">@(next == null ? "None" : Display.Date(next.Event.EventDate))</strong><span>Next event date</span></div></div>
</div>
@if (Model.Count == 0)
{
    <div class="rd-empty"><h2>No events yet</h2><p>Create your first event to open entries.</p></div>
}
else
{
    <div class="table-responsive rd-table">
        <table class="table align-middle mb-0">
            <thead><tr><th>Event</th><th>Date</th><th>Type</th><th>Enrolments</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var e = item.Event;
                    var isUpcoming = e.EventDate > now;
                    <tr>
                        <td><a asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId">@e.Name</a></td>
                        <td>@Display.DateTimeText(e.EventDate)</td>
                        <td>@e.Discipline</td>
                        <td>@item.TotalEnrolments</td>
                        <td>@(isUpcoming ? "Upcoming" : "Completed")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Categories" asp-route-id="@e.EventId">Categories</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Enrolments" asp-route-id="@e.EventId">Enrolments</a>
                            @if (isUpcoming)
                            {
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@e.EventId">Edit</a>
                            }
                            else
                            {
                                <a class="btn btn-sm rd-btn" asp-action="Results" asp-route-id="@e.EventId">Results</a>
                            }
                            <form class="d-inline" asp-action="Delete" asp-route-id="@e.EventId" method="post"
                                  onsubmit="return confirm('Delete @e.Name.Replace("'", "")?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
